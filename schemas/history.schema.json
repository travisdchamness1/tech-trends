{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/travisdchamness1/tech-trends/schemas/history.schema.json",
  "title": "Technology Trends compact derived history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "timezone", "ledger_authority", "created_at", "updated_at", "latest_successful_run_id", "runs", "finding_events", "category_observations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "technology_trend_history_index"},
    "timezone": {"const": "America/Los_Angeles"},
    "ledger_authority": {"const": "data/runs"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "latest_successful_run_id": {"type": ["string", "null"]},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run_index"}},
    "finding_events": {"type": "array", "items": {"$ref": "#/$defs/finding_event"}},
    "category_observations": {"type": "array", "items": {"$ref": "#/$defs/category_observation"}}
  },
  "$defs": {
    "run_index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "scheduled_for", "observed_at", "window_start", "window_end", "status", "run_record_path", "report_path", "finding_count"],
      "properties": {
        "run_id": {"type": "string"},
        "scheduled_for": {"type": "string", "format": "date-time"},
        "observed_at": {"type": "string", "format": "date-time"},
        "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"},
        "status": {"const": "success"},
        "run_record_path": {"type": "string", "pattern": "^data/runs/"},
        "report_path": {"type": "string", "pattern": "^reports/"},
        "finding_count": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "finding_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_key", "latest_finding_id", "first_seen_run_id", "last_seen_run_id", "source_urls"],
      "properties": {
        "event_key": {"type": "string"},
        "latest_finding_id": {"type": "string"},
        "first_seen_run_id": {"type": "string"},
        "last_seen_run_id": {"type": "string"},
        "source_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^https?://"}}
      }
    },
    "category_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "scheduled_for", "category_id", "direction", "velocity_score", "confidence", "justification", "evidence_count", "report_path"],
      "properties": {
        "run_id": {"type": "string"},
        "scheduled_for": {"type": "string", "format": "date-time"},
        "category_id": {"type": "string"},
        "direction": {"enum": ["up", "down", "flat", "unknown"]},
        "velocity_score": {"type": "integer", "minimum": -2, "maximum": 2},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "justification": {"type": "string", "minLength": 1},
        "evidence_count": {"type": "integer", "minimum": 0},
        "report_path": {"type": "string", "pattern": "^reports/"}
      }
    }
  }
}
